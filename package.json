{
  "name": "jinshansong",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:api": "pnpm --filter @jinshansong/api dev",
    "dev:admin": "NEXT_PUBLIC_API_BASE_URL=http://localhost:3001 pnpm --filter @jinshansong/admin-web dev",
    "dev:user": "pnpm --filter @jinshansong/user-miniapp dev:h5",
    "dev:merchant": "pnpm --filter @jinshansong/merchant-miniapp dev:h5",
    "dev:preview:local": "pnpm dev:user & pnpm dev:merchant & pnpm dev:admin & wait",
    "dev:admin:server-preview": "NEXT_PUBLIC_API_BASE_URL=http://118.25.15.82 pnpm --filter @jinshansong/admin-web dev",
    "dev:user:server-preview": "VITE_API_BASE_URL=http://118.25.15.82 API_PUBLIC_BASE_URL=http://118.25.15.82 pnpm --filter @jinshansong/user-miniapp dev:h5",
    "dev:merchant:server-preview": "VITE_API_BASE_URL=http://118.25.15.82 API_PUBLIC_BASE_URL=http://118.25.15.82 pnpm --filter @jinshansong/merchant-miniapp dev:h5",
    "dev:preview:server": "pnpm dev:user:server-preview & pnpm dev:merchant:server-preview & pnpm dev:admin:server-preview & wait",
    "mp:local": "node scripts/configure-miniapp-appids.mjs --mode=local",
    "mp:real": "node scripts/configure-miniapp-appids.mjs --mode=real",
    "build:mp": "pnpm build:mp:user && pnpm build:mp:merchant",
    "build:mp:local": "pnpm mp:local && pnpm build:mp",
    "build:mp:local-preview": "pnpm mp:real && VITE_API_BASE_URL=http://127.0.0.1:3001 VITE_MP_API_BASE_URL=http://127.0.0.1:3001 API_PUBLIC_BASE_URL=http://127.0.0.1:3001 pnpm build:mp",
    "build:mp:real": "pnpm mp:real && pnpm build:mp",
    "build:mp:server-preview": "pnpm mp:real && VITE_API_BASE_URL=http://118.25.15.82 VITE_MP_API_BASE_URL=http://118.25.15.82 API_PUBLIC_BASE_URL=http://118.25.15.82 pnpm build:mp",
    "build:mp:user": "pnpm --filter @jinshansong/user-miniapp build:mp-weixin",
    "build:mp:merchant": "pnpm --filter @jinshansong/merchant-miniapp build:mp-weixin",
    "open:mp:user": "\"/Applications/wechatwebdevtools.app/Contents/MacOS/cli\" open --project \"$PWD/apps/user-miniapp/dist/build/mp-weixin\"",
    "open:mp:merchant": "\"/Applications/wechatwebdevtools.app/Contents/MacOS/cli\" open --project \"$PWD/apps/merchant-miniapp/dist/build/mp-weixin\"",
    "wechat:mock": "node scripts/configure-wechat-login-mode.mjs --mode=mock",
    "wechat:real": "node scripts/configure-wechat-login-mode.mjs --mode=real",
    "check:miniapp": "node scripts/preflight-miniapp.mjs",
    "check:env": "node scripts/check-runtime-targets.mjs",
    "check:env:local": "node scripts/check-runtime-targets.mjs --target=local",
    "check:env:server": "node scripts/check-runtime-targets.mjs --target=server",
    "check:prod": "node scripts/preflight-production.mjs",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test:data-flow": "node scripts/smoke-data-flow.mjs",
    "test:onboarding-flow": "node scripts/smoke-onboarding-order-flow.mjs",
    "format": "prettier --write .",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma --name init",
    "db:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@prisma/client": "^6.19.3",
    "@types/node": "^24.9.2",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "prisma": "^6.19.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4"
  },
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  }
}
