NODE_ENV=development
PORT=3001

DATABASE_URL="postgresql://jinshansong:jinshansong@localhost:5432/jinshansong?schema=public"
REDIS_URL="redis://localhost:6379"

# 后端签名 token 密钥；正式环境必须换成高强度随机值
JWT_SECRET="dev-only-change-me"
ADMIN_DEFAULT_ACCOUNT="admin"
ADMIN_DEFAULT_PASSWORD="admin123456"

NEXT_PUBLIC_API_BASE_URL="http://localhost:3001"
VITE_API_BASE_URL="http://localhost:3001"
# 微信开发者工具本地预览可用 127.0.0.1；真机/正式版必须换成 HTTPS API 域名
VITE_MP_API_BASE_URL="http://127.0.0.1:3001"

# 微信小程序前端工程 AppID：
# 本地预览可留空，构建后使用 touristappid；正式发布必须分别填写两个真实 AppID
MP_WEIXIN_MODE="local"
MP_WEIXIN_USER_APP_ID=""
MP_WEIXIN_MERCHANT_APP_ID=""

# 微信登录双模式：
# mock：本地/H5/开发者工具 touristappid 预览，自动生成模拟 openId
# real：正式 AppID + AppSecret，后端调用微信 code2Session 和手机号授权接口
WECHAT_LOGIN_MODE="mock"
# real 模式下，下面两个登录 AppID 必须分别等于 MP_WEIXIN_USER_APP_ID / MP_WEIXIN_MERCHANT_APP_ID
WECHAT_USER_APP_ID=""
WECHAT_USER_APP_SECRET=""
WECHAT_MERCHANT_APP_ID=""
WECHAT_MERCHANT_APP_SECRET=""
WECHAT_API_BASE_URL="https://api.weixin.qq.com"

# 上传适配器：当前 MVP 使用 LOCAL，后续可替换为 COS/OSS 并保持返回 URL 结构不变
# 微信真机/正式版展示上传图片时，API_PUBLIC_BASE_URL 必须是 HTTPS 可访问域名
API_PUBLIC_BASE_URL="http://localhost:3001"
UPLOAD_DRIVER="LOCAL"
UPLOAD_BUCKET=""
UPLOAD_MAX_IMAGE_MB=5

# 门店 3 分钟未接单自动转单轮询间隔；设为 0 可关闭本地轮询
JOB_STORE_TIMEOUT_INTERVAL_MS=30000
